{
  "name": "@six5536/pakf-workspace",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "@six5536/pakf-workspace",
      "workspaces": [
        "packages/cli"
      ]
    },
    "node_modules/@six5536/pakf": {
      "resolved": "packages/cli",
      "link": true
    },
    "packages/cli": {
      "name": "@six5536/pakf",
      "version": "0.2.0",
      "license": "Elastic-2.0",
      "bin": {
        "pakf": "bin/cli.js"
      },
      "engines": {
        "node": ">=18"
      },
      "optionalDependencies": {
        "@six5536/pakf-darwin-arm64": "0.2.0",
        "@six5536/pakf-darwin-x64": "0.2.0",
        "@six5536/pakf-linux-arm64": "0.2.0",
        "@six5536/pakf-linux-x64": "0.2.0",
        "@six5536/pakf-win32-x64": "0.2.0"
      }
    }
  }
}
